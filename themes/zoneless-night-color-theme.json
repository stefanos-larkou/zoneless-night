{
    "$schema": "vscode://schemas/color-theme",
    "name": "Zoneless Night",
    "type": "dark",
    "semanticHighlighting": false,
    "colors": {
        "editor.background": "#0F0F11",
        "editor.foreground": "#EFEFF1",
        "editorLineNumber.foreground": "#8A8A93",
        "editorLineNumber.activeForeground": "#F637E3",
        "editorCursor.foreground": "#F637E3",
        "editor.selectionBackground": "#F637E344",
        "editor.selectionHighlightBackground": "#F637E322",
        "editor.wordHighlightBackground": "#F637E322",
        "editor.findMatchBackground": "#F637E355",
        "editor.findMatchHighlightBackground": "#F637E322",
        "editor.lineHighlightBackground": "#17171A",
        "editorIndentGuide.background1": "#2A2A30",
        "editorIndentGuide.activeBackground1": "#E90464",
        "editorWhitespace.foreground": "#2A2A30",
        "editorBracketMatch.background": "#F637E322",
        "editorBracketMatch.border": "#F637E3",
        "editorGroup.border": "#2A2A30",
        "editorWidget.background": "#17171A",
        "editorWidget.border": "#2A2A30",
        "editorSuggestWidget.selectedBackground": "#F637E333",
        "editorSuggestWidget.highlightForeground": "#F637E3",
        "editorHoverWidget.background": "#17171A",
        "editorHoverWidget.border": "#2A2A30",
        "focusBorder": "#F637E3",
        "activityBar.background": "#0F0F11",
        "activityBar.foreground": "#EFEFF1",
        "activityBar.inactiveForeground": "#8A8A93",
        "activityBar.border": "#2A2A30",
        "activityBar.activeBorder": "#F637E3",
        "activityBarBadge.background": "#8514F5",
        "activityBarBadge.foreground": "#FFFFFF",
        "sideBar.background": "#0F0F11",
        "sideBar.foreground": "#B4B4BC",
        "sideBar.border": "#2A2A30",
        "sideBarTitle.foreground": "#B4B4BC",
        "sideBarSectionHeader.background": "#17171A",
        "sideBarSectionHeader.border": "#2A2A30",
        "tab.activeBackground": "#0F0F11",
        "tab.activeForeground": "#EFEFF1",
        "tab.activeBorderTop": "#E90464",
        "tab.inactiveBackground": "#17171A",
        "tab.inactiveForeground": "#8A8A93",
        "tab.border": "#2A2A30",
        "editorGroupHeader.tabsBackground": "#17171A",
        "editorGroupHeader.tabsBorder": "#2A2A30",
        "titleBar.activeBackground": "#0F0F11",
        "titleBar.activeForeground": "#B4B4BC",
        "titleBar.inactiveBackground": "#0F0F11",
        "titleBar.inactiveForeground": "#8A8A93",
        "titleBar.border": "#2A2A30",
        "statusBar.background": "#0F0F11",
        "statusBar.foreground": "#FFFFFF",
        "statusBar.border": "#2A2A30",
        "statusBar.noFolderBackground": "#0F0F11",
        "statusBar.debuggingBackground": "#E90464",
        "statusBar.debuggingForeground": "#FFFFFF",
        "statusBarItem.remoteBackground": "#E90464",
        "statusBarItem.remoteForeground": "#FFFFFF",
        "statusBarItem.hoverBackground": "#F637E322",
        "panel.background": "#0F0F11",
        "panel.border": "#2A2A30",
        "panelTitle.activeForeground": "#EFEFF1",
        "panelTitle.inactiveForeground": "#8A8A93",
        "panelTitle.activeBorder": "#F11653",
        "button.background": "#F637E3",
        "button.foreground": "#000000",
        "button.hoverBackground": "#9E45F7",
        "progressBar.background": "#F637E3",
        "badge.background": "#F637E3",
        "badge.foreground": "#000000",
        "extensionButton.prominentBackground": "#F637E3",
        "extensionButton.prominentForeground": "#000000",
        "extensionButton.prominentHoverBackground": "#9E45F7",
        "input.background": "#17171A",
        "input.foreground": "#EFEFF1",
        "input.placeholderForeground": "#8A8A93",
        "dropdown.background": "#17171A",
        "dropdown.foreground": "#EFEFF1",
        "inputOption.activeBorder": "#F637E3",
        "list.activeSelectionBackground": "#F637E333",
        "list.activeSelectionForeground": "#EFEFF1",
        "list.inactiveSelectionBackground": "#F637E31a",
        "list.hoverBackground": "#17171A",
        "list.highlightForeground": "#F637E3",
        "list.focusOutline": "#F637E3",
        "tree.indentGuidesStroke": "#2A2A30",
        "scrollbarSlider.background": "#8A8A9344",
        "scrollbarSlider.hoverBackground": "#F637E355",
        "scrollbarSlider.activeBackground": "#F637E388",
        "minimap.findMatchHighlight": "#F637E3",
        "terminal.foreground": "#EFEFF1",
        "terminalCursor.foreground": "#F637E3",
        "terminal.ansiBlue": "#8514F5",
        "terminal.ansiMagenta": "#F637E3",
        "terminal.ansiRed": "#F11653",
        "textLink.foreground": "#F637E3",
        "textLink.activeForeground": "#F637E3",
        "gitDecoration.modifiedResourceForeground": "#E90464",
        "peekView.border": "#E90464",
        "notificationLink.foreground": "#F637E3"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#489C66",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#F03618"
            }
        },
        {
            "name": "Numbers/Constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character"
            ],
            "settings": {
                "foreground": "#2AEA18"
            }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "storage",
                "storage.type"
            ],
            "settings": {
                "foreground": "#F637E3"
            }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function"
            ],
            "settings": {
                "foreground": "#F6F6BA"
            }
        },
        {
            "name": "Classes/Types",
            "scope": [
                "entity.name.class",
                "entity.name.type",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": {
                "foreground": "#5A8490"
            }
        },
        {
            "name": "Variables/Parameters",
            "scope": [
                "variable",
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#AEDEFC"
            }
        },
        {
            "name": "Tags (HTML/Angular templates)",
            "scope": [
                "entity.name.tag",
                "meta.tag"
            ],
            "settings": {
                "foreground": "#F637E3"
            }
        },
        {
            "name": "Attributes",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#AEDEFC"
            }
        },
        {
            "name": "Operators/Punctuation",
            "scope": [
                "keyword.operator",
                "punctuation"
            ],
            "settings": {
                "foreground": "#90C0B4"
            }
        },
        {
            "name": "Decorators (Angular/TS)",
            "scope": [
                "meta.decorator",
                "punctuation.decorator"
            ],
            "settings": {
                "foreground": "#F6F6BA"
            }
        },
        {
            "name": "string",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#2fd062"
            }
        },
        {
            "name": "constant.numeric",
            "scope": [
                "constant.numeric"
            ],
            "settings": {
                "foreground": "#ff8a8a"
            }
        },
        {
            "name": "entity.name.type",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.other.inherited-class",
                "support.class",
                "support.type",
                "entity.name.type.class",
                "entity.name.type.interface"
            ],
            "settings": {
                "foreground": "#a05cff"
            }
        },
        {
            "name": "variable",
            "scope": [
                "variable",
                "variable.parameter",
                "variable.other.readwrite",
                "variable.other.object",
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property"
            ],
            "settings": {
                "foreground": "#7f96ff"
            }
        },
        {
            "name": "variable.language.this",
            "scope": [
                "variable.language.this",
                "variable.language.super"
            ],
            "settings": {
                "foreground": "#5672ff"
            }
        },
        {
            "name": "entity.name.function",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call entity.name.function"
            ],
            "settings": {
                "foreground": "#5ee8c6"
            }
        },
        {
            "name": "punctuation.decorator",
            "scope": [
                "punctuation.decorator",
                "meta.decorator punctuation.decorator"
            ],
            "settings": {
                "foreground": "#5ee8c6"
            }
        },
        {
            "name": "constant.language.boolean",
            "scope": [
                "constant.language.boolean"
            ],
            "settings": {
                "foreground": "#ff5c5c"
            }
        },
        {
            "name": "constant.language.null",
            "scope": [
                "constant.language.null"
            ],
            "settings": {
                "foreground": "#d23c3c"
            }
        },
        {
            "name": "constant.language.undefined",
            "scope": [
                "constant.language.undefined"
            ],
            "settings": {
                "foreground": "#df7a26"
            }
        },
        {
            "name": "keyword.operator.new",
            "scope": [
                "keyword.operator.new"
            ],
            "settings": {
                "foreground": "#F637E3",
                "fontStyle": "bold"
            }
        },
        {
            "name": "entity.other.ng-binding-name.template.html",
            "scope": [
                "entity.other.ng-binding-name.template.html",
                "meta.ng-binding.template.html punctuation.definition.ng-binding-name.begin.html"
            ],
            "settings": {
                "foreground": "#ff9a3c"
            }
        },
        {
            "name": "keyword.control.block.kind.ng",
            "scope": [
                "keyword.control.block.kind.ng",
                "keyword.control.block.transition.ng"
            ],
            "settings": {
                "foreground": "#8a2bff"
            }
        },
        {
            "name": "entity.other.ng-binding-name.event.html",
            "scope": [
                "entity.other.ng-binding-name.event.html",
                "meta.ng-binding.event.html punctuation.definition.ng-binding-name.begin.html",
                "meta.ng-binding.event.html punctuation.definition.ng-binding-name.end.html"
            ],
            "settings": {
                "foreground": "#ffd75e"
            }
        },
        {
            "name": "entity.name.function.pipe.ng",
            "scope": [
                "entity.name.function.pipe.ng"
            ],
            "settings": {
                "foreground": "#e7a6ff"
            }
        },
        {
            "name": "support.type.primitive",
            "scope": [
                "support.type.primitive",
                "support.type.builtin"
            ],
            "settings": {
                "foreground": "#f5c451"
            }
        },
        {
            "name": "variable.other.enummember",
            "scope": [
                "variable.other.enummember"
            ],
            "settings": {
                "foreground": "#ffb86c"
            }
        },
        {
            "name": "keyword.control.at-rule punctuation.definition.keyword",
            "scope": [
                "keyword.control.at-rule punctuation.definition.keyword"
            ],
            "settings": {
                "foreground": "#F637E3"
            }
        }
    ],
    "semanticTokenColors": {
        "class": "#a05cff",
        "interface": "#a05cff",
        "type": "#a05cff",
        "enum": "#a05cff",
        "typeParameter": "#a05cff",
        "variable": "#7f96ff",
        "parameter": "#7f96ff",
        "property": "#7f96ff",
        "function": "#5ee8c6",
        "method": "#5ee8c6",
        "enumMember": "#ffb86c"
    }
}
